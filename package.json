{
  "name": "codex-on-cloud",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "reset-password": "node scripts/reset-password.mjs",
    "deploy": "node scripts/deploy.mjs",
    "start": "node panel/main.mjs",
    "desktop": "node native/desktop.mjs",
    "native:install": "node scripts/native.mjs install",
    "native:doctor": "node scripts/native.mjs doctor",
    "native:start": "node scripts/native.mjs start",
    "native:status": "node scripts/native.mjs status",
    "native:stop": "node scripts/native.mjs stop",
    "native:tunnel": "node scripts/native.mjs tunnel",
    "native:cloudflared": "node scripts/install-cloudflared.mjs",
    "native:publish": "node scripts/provision-cloudflare.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test test/*.test.mjs",
    "test:desktop": "python3 -m unittest discover -s test -p '*_test.py'",
    "test:browser": "playwright test",
    "test:compat": "playwright test -c playwright.compat.config.mjs",
    "test:native": "node test/native-smoke.mjs",
    "test:display": "node test/terminal-native.mjs",
    "test:viewport": "node test/viewport-native.mjs",
    "test:pointer": "node test/pointer-native.mjs",
    "test:lifecycle": "node test/lifecycle-native.mjs",
    "test:recovery": "node test/recovery-native.mjs",
    "test:terminal-only": "node test/terminal-only-native.mjs",
    "build:forward": "node scripts/build-forward.mjs",
    "test:forward": "node test/forward-native.mjs",
    "test:forward:package": "node test/forward-package-native.mjs",
    "demo": "node scripts/demo.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "multicast-dns": "7.2.5",
    "werift": "0.26.0",
    "ws": "8.22.1"
  },
  "optionalDependencies": { "@novnc/novnc": "1.7.0" },
  "devDependencies": { "@playwright/test": "1.64.1" }
}
