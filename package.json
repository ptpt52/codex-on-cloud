{
  "name": "codex-on-cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node panel/main.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test test/*.test.mjs",
    "test:desktop": "python3 -m unittest discover -s test -p '*_test.py'",
    "test:browser": "playwright test",
    "demo": "node scripts/demo.mjs"
  },
  "dependencies": { "http-proxy-middleware": "4.2.1" },
  "devDependencies": { "@playwright/test": "1.64.1", "ws": "8.22.1" }
}
