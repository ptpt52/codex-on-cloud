# 建议由 npm run setup 生成真正的 .env 和随机密钥。
# 域名接入时使用自己的 HTTPS 根地址，例如 https://desk.example.com。
DEPLOY_MODE=desktop
PUBLIC_ORIGIN=http://localhost:36080
# 额外允许的精确 Host，不带协议、不支持通配符；需要端口时一并填写。
# 对外主域名已由 PUBLIC_ORIGIN 自动加入。网关节点可在这里保留独立域名，
# 但不要加入私有 backend 主机名。
ALLOWED_HOSTS=127.0.0.1:36080
ADMIN_USER=admin
PANEL_PORT=36080
# 可选独立文件助手；先按 docs/ui-updates.md 部署服务，再设置此端口。
# 不设置时仍使用宿主的 AGENT_PORT（默认 36902）。
# FILE_AGENT_PORT=36904
# 用户终端总数（包含主终端，不含内部保活），范围 1–8；默认 4。
# 修改后重启 manager 和 panel，保留已运行的终端任务。
MAX_TERMINALS=4
DESKTOP_SIZE=1600x3200
# 默认启用局域网 IPv4 / 公网 IPv6 加密直连；失败后中转并持续探测。
WEBRTC_ENABLED=1
# 可选：多网卡时固定接口。不填则在每次协商时自动选择当前私有 IPv4。
# WEBRTC_LAN_ADDRESS=192.168.1.100
# 默认自动选择本机公网 IPv6。设为 0 可关闭公网 IPv6 直连。
WEBRTC_IPV6=1
# 可选：固定已分配给本机的公网 IPv6，否则每次协商重新选择。
# WEBRTC_IPV6_ADDRESS=你的公网IPv6
# 仅浏览器地址发现，不转发桌面；设为空字符串可关闭 STUN。
WEBRTC_STUN_URL=stun:stun.cloudflare.com:3478
# Tunnel 按所在主机的解析顺序选择地址族，并保留双栈故障回退。
TUNNEL_EDGE_IP_VERSION=auto
# 固定的回环诊断端口，不对公网发布。
TUNNEL_METRICS_PORT=36903
# TCP 映射目标端口：* 可自定义；也可填写 22,5432 或留空禁用。管理端口始终排除。
TCP_FORWARD_PORTS=*
WORKSPACE_DIR=./workspaces
# 本机 Node / Codex 版本由管理员维护，不通过 .env 自动安装或升级。
TZ=Asia/Shanghai
