# 建议由 npm run setup 生成真正的 .env 和随机密钥。
# Cloudflare 部署时改成 https://desktop.example.com。
PUBLIC_ORIGIN=http://localhost:36080
# 额外允许的 Host，带端口；对外域名已由 PUBLIC_ORIGIN 自动加入。
ALLOWED_HOSTS=127.0.0.1:36080
ADMIN_USER=admin
PANEL_PORT=36080
DESKTOP_SIZE=1280x1000
WORKSPACE_DIR=./workspaces
CODEX_VERSION=0.166.0
TZ=Asia/Shanghai
