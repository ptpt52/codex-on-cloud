#!/usr/bin/env bash
set -eu
script_dir="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)"
cd "${WORKSPACE_DIR:?}"
# A separate socket avoids attaching to, or changing, the physical desktop's tmux server.
exec tmux -f "$script_dir/tmux.conf" -S "${TMUX_SOCKET:?}" new-session -A -s codex bash "$script_dir/codex-session"
